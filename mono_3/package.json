{
  "name": "northwind-commerce",
  "version": "3.4.1",
  "private": true,
  "description": "Intentionally vulnerable scanner target (TypeScript/Node monorepo)",
  "workspaces": [
    "packages/shared",
    "packages/gateway",
    "packages/auth",
    "packages/payments",
    "packages/catalog",
    "packages/uploads",
    "packages/admin",
    "packages/webhooks",
    "packages/web",
    "packages/ghost-service"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "tsc -b && npm --workspace packages/web run build",
    "test": "jest --passWithNoTests",
    "lint": "eslint . || true"
  },
  "devDependencies": {
    "typescript": "4.9.5",
    "ts-node": "10.9.1",
    "jest": "29.7.0",
    "turbo": "1.10.16"
  }
}
